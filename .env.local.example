# Copy this file to .env.local and fill in real values once the backend is ready.
# Until these are set (or reachable), the app runs entirely on mock data —
# see lib/api.ts and lib/useCallTranscript.ts for the fallback logic.

# REST API base URL (Java backend). Example endpoints expected — see lib/api.ts
# for the exact shape of each: /contacts, /leads, /leads/stats, /deals, /calls,
# /dashboard/summary, /analytics/dashboard
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# WebSocket base URL for the AI Voice Agent's live transcript stream.
# Expected path: ${NEXT_PUBLIC_WS_URL}/calls/:callId/transcript
# Expected message shape (one JSON object per frame):
#   { "speaker": "AI" | "Customer", "text": "...", "time": "10:42 AM" }
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
